# ----- Django -----
SECRET_KEY=troque-esta-chave-em-producao
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:5173
SITE_NAME=Pauta

# ----- Banco de dados -----
# DB_ENGINE aceita "postgres" (padrao) ou "sqlite" (util para rodar sem instalar o Postgres)
DB_ENGINE=postgres
DB_NAME=pauta
DB_USER=postgres
DB_PASSWORD=1234
DB_HOST=localhost
DB_PORT=5432

# ----- CORS -----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ----- JWT -----
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# ----- E-mail (recuperacao de senha) -----
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=nao-responda@pauta.local

# ----- Redis (cache compartilhado + fila do Celery) -----
# Em desenvolvimento pode ficar vazio (cache em memoria). Em producao use o Redis.
REDIS_URL=
CELERY_BROKER_URL=redis://localhost:6379/0

# ----- Coleta automatica de noticias -----
COLETA_INTERVALO_MINUTOS=40
# Ao iniciar o beat pela primeira vez (sem agenda salva), coleta na hora se estiver atrasada
COLETA_EXECUTAR_AO_INICIAR=True
# Trava contra coletas simultaneas: auto (PostgreSQL=banco, senao arquivo) | banco | arquivo | cache
COLETA_TRAVA_BACKEND=auto
# COLETA_TRAVA_ARQUIVO=.coleta.lock
# Onde o beat guarda a ultima execucao (mantem o agendamento apos reiniciar)
# CELERY_BEAT_SCHEDULE_FILENAME=celerybeat-schedule
COLETA_IDADE_MAXIMA_DIAS=7
COLETA_TIMEOUT_CONEXAO=5
COLETA_TIMEOUT_LEITURA=20
COLETA_TAMANHO_MAXIMO_MB=5
COLETA_RETENCAO_LOGS_DIAS=30
COLETA_PONTUACAO_MINIMA=2
COLETA_LOG_LEVEL=INFO
# COLETA_LOG_ARQUIVO=logs/coleta.log
# Segundos que a lista do carrossel fica em cache (e limpa sozinha a cada importacao)
CARROSSEL_CACHE_SEGUNDOS=60

# ----- Faixa "Urgente" (topo do site) -----
# True: preenche sozinha com as ultimas noticias publicadas, alem das marcadas como urgentes
URGENTE_AUTOMATICO=True
# So entram noticias publicadas nas ultimas N horas
URGENTE_JANELA_HORAS=6
URGENTE_MAXIMO=5
# So para desenvolvimento: aceitar feeds servidos na propria maquina (localhost/rede interna)
COLETA_PERMITIR_REDE_INTERNA=False
# Chaves de APIs de noticias ficam aqui; no cadastro da fonte vai so o NOME da variavel:
# NEWSAPI_KEY=
