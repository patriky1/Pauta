# ----- Django -----
SECRET_KEY=troque-esta-chave-em-producao
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:5173
SITE_NAME=Pauta

# ----- Banco de dados -----
# DB_ENGINE aceita "postgres" (padrao) ou "sqlite" (util para rodar sem instalar o Postgres)
DB_ENGINE=postgres
DB_NAME=pauta
DB_USER=postgres
DB_PASSWORD=1234
DB_HOST=localhost
DB_PORT=5432

# ----- CORS -----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ----- JWT -----
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# ----- E-mail (recuperacao de senha) -----
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=nao-responda@pauta.local
